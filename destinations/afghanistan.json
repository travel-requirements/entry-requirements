  "tips": [
    {
      "id": "do-not-travel",
      "type": "warning",
      "text": "The UK, Canadian and Australian governments advise against all travel to Afghanistan. The UK says British nationals face a high risk of detention or kidnap, that detainees could spend months or years in prison without clarity about the charges, and that it cannot give in-person consular help there."
    },
    {
      "id": "women-restrictions",
      "type": "warning",
      "text": "The UK government's travel advice says the Taliban have made it illegal for women to travel more than 72 km without a husband, father or brother (a mahram), and that women, including foreign nationals, must fully cover themselves in public, with a veil over the face. Canada's advice says women are prohibited from travelling and going to public places such as parks and restaurants without a male guardian."
    },
    {
      "id": "checkpoints-permits",
      "type": "info",
      "text": "Canada's travel advice says there are checkpoints on all roads and throughout cities. The UK government's advice says photographing government buildings, military installations, palaces or Taliban checkpoints is not allowed and may lead to detention, and to avoid photographing people without their agreement."
    },
    {
      "id": "visa-route",
      "type": "tip",
      "text": "The Ministry of Foreign Affairs says a tourist visa is issued on the basis of the applicant's travel purpose and documents such as a valid passport and a hotel booking. A visa on arrival at Kabul International Airport exists only for visitors with an official letter from an Afghan organisation or an invitation from an international organisation working in Afghanistan, approved by the Ministry of Foreign Affairs."
    },
    {
      "id": "local-law",
      "type": "info",
      "text": "The UK government's travel advice says the Taliban set and strictly enforce dress codes for men and women, that alcohol, narcotics and pork are not allowed, and that there are no formal, internationally recognised legal processes — foreign nationals have been detained without due process."
    }
  ],
  "faq": [
    {
      "id": "need-visa",
      "question": "Do I need a visa for Afghanistan?",
      "answer": "Foreign nationals of Afghan origin can enter on an entry permit without a visa if their passport gives Afghanistan as their place of birth, or if they hold a tazkira, an Afghan passport or a certificate of identity from an Afghan mission. For everyone else, the Ministry of Foreign Affairs lists its visa types but does not say which nationalities need a visa; the UK, Canadian and German governments say their citizens need a visa to enter. A visa on arrival at Kabul International Airport is issued only against an official letter from an Afghan organisation or an invitation from an international organisation working in Afghanistan, with the Ministry of Foreign Affairs’ approval."
    },
    {
      "id": "is-it-safe",
      "question": "Is Afghanistan safe to visit?",
      "answer": "No. The UK, Canadian and Australian governments advise against all travel to Afghanistan. The UK says there is a high risk of British nationals being detained or kidnapped, that terrorists often target places foreigners visit, and that it has no embassy there and cannot give in-person consular help; Canada says its ability to help is extremely limited."
    },
    {
      "id": "women-travel",
      "question": "Can women travel to Afghanistan?",
      "answer": "Entry is possible with a visa, but the UK government's travel advice says the Taliban have made it illegal for women to travel more than 72 km without a male relative (a mahram) and require women, including foreigners, to fully cover themselves in public. Canada's advice says women cannot travel or go to public places without a male guardian and are at particular risk of harassment and abuse, including from the authorities."
    },
    {
      "id": "money",
      "question": "Can I use cards or ATMs in Afghanistan?",
      "answer": "Mostly no. Canada's travel advice says Afghanistan is a cash-based economy where credit cards are not widely accepted and ATMs are found in major cities but few or none in rural areas. The UK government says some ATMs and many banks accept foreign-issued cards with withdrawal limits, and that it is illegal to carry more than US$5,000 in cash through airports or US$500 through land borders."
    }
  ]

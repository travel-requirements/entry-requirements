  "tips": [
    {
      "id": "security-advisories",
      "type": "warning",
      "text": "The UK Foreign Office advises against all travel to several communes and roads near the Kibira National Park and the border with the DR Congo, where armed-group activity has increased."
    },
    {
      "id": "cash-usd",
      "type": "tip",
      "text": "The UK Foreign Office advises taking US dollars dated after 2006, saying most businesses will not accept or exchange older notes and notes with small tears are rejected. It says outside Bujumbura cards are rarely accepted and ATMs are few, and advises not relying on cash withdrawals."
    },
    {
      "id": "photography",
      "type": "info",
      "text": "The Government of Canada says photographing sensitive installations — ports, military sites, government buildings and people in uniform — is prohibited. Always ask permission before photographing official buildings or individuals."

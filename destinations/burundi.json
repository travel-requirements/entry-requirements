  "faq": [
    {
      "id": "need-visa",
      "question": "Do I need a visa for Burundi?",
      "answer": "Burundi’s migration authority does not publish which nationalities need a visa; the UK and Canadian governments say their citizens do. The authority issues the single-entry visa (one month) online at migration.gov.bi, at Melchior Ndadaye International Airport or at embassies. Citizens of East African Community countries such as Kenya, Tanzania, Uganda and Rwanda can get a free EAC entry visa from the CGM instead."
    },
    {
      "id": "eac-visa-free",
      "question": "Which passports get a free EAC visa?",
      "answer": "The migration authority (CGM) lists a free “EAC entry visa” for citizens of East African Community member states — Kenya, Tanzania, Uganda, Rwanda, South Sudan, the DR Congo and Somalia — valid for 1 to 6 months."
    },
    {
      "id": "visa-on-arrival",
      "question": "Can I get a visa on arrival in Burundi?",
      "answer": "Yes, at the airport: Burundi's migration authority says the entry visa is obtained online, at Melchior Ndadaye International Airport or at embassies, and it runs an online application for the airport entry visa. The transit visa (USD 40, three days) is issued at any point of entry."
    },
    {
      "id": "yellow-fever",
      "question": "Do I need a yellow fever certificate for Burundi?",
      "answer": "Yes. The UK and Canadian travel advice both say a yellow fever vaccination certificate is required to enter Burundi, whichever country you arrive from."
    },
    {
      "id": "is-burundi-safe",
      "question": "Is Burundi safe to visit?",
      "answer": "The UK Foreign Office advises against all travel to parts of the north-west near the Kibira National Park and the DR Congo border, where armed-group activity and conflict have increased, and the Government of Canada advises avoiding non-essential travel to Burundi."
    }
  ]
}

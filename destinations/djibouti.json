  "tips": [
    {
      "id": "evisa-before-travel",
      "type": "info",
      "text": "The eVisa portal says the eVisa replaces the visa issued at the point of entry, that no visas will be issued at the airport or any other border point as of May 1, 2018, and that once your application is approved you can download your e-visa in PDF format. The UK government says you can buy a tourist visa when you arrive, paid in cash in US dollars."
    },
    {
      "id": "border-areas",
      "type": "warning",
      "text": "The UK government advises against all travel to the Djibouti-Eritrea border, and Canada advises avoiding non-essential travel to the area within 10 km of Djibouti's border with Eritrea."
    }
  ],
  "faq": [
    {
      "id": "need-visa",
      "question": "Do I need a visa for Djibouti?",
      "answer": "The UK, Canadian, Australian and Italian governments say their citizens need a visa. Djibouti's official eVisa portal, evisa.gouv.dj, says the eVisa application is open to everyone except holders of diplomatic, service or official passports and those benefiting from a courtesy visa program, but no official source we could read states which other nationalities need a visa. A transit visa covers 1 to 14 days and a short-stay visa 15 to 90 days."
    },
    {
      "id": "visa-on-arrival",
      "question": "Can I get a visa on arrival in Djibouti?",
      "answer": "The official sources differ. The eVisa portal says no visas will be issued at the airport or any other border point as of May 1, 2018, and that the eVisa replaces the visa issued at the point of entry, usually an airport or border crossing; the UK government says you can buy a tourist visa when you arrive, paid in cash in US dollars, or apply for a visa online before travelling."
    },
    {
      "id": "evisa-cost",
      "question": "How much does the Djibouti eVisa cost?",
      "answer": "The official eVisa portal says eVisa fees vary by visa type: a transit visa (from 1 to 14 days) costs USD 12 and a short-stay visa (from 15 to 90 days) USD 23."
    }
  ],

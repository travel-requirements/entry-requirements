    "customs": {
      "currencyLimits": {
        "text": "Foreign cash or travellers' cheques worth USD 10,000 or more must be declared on arrival; keep the certificate you are given to show when you leave. On departure you must be able to show that any foreign currency you spent was exchanged at Himbol, the state exchange, or spent at an official hotel, and you may not take more than 1,000 nakfa out of Eritrea.",
        "source": {
          "url": "https://www.gov.uk/foreign-travel-advice/eritrea/entry-requirements",
          "name": "UK FCDO — Eritrea travel advice, entry requirements",
          "type": "government",
          "lastVerified": "2026-10-03",
          "lastChanged": "2026-09-26"
        }
      },
      "notes": [
        "Exchange foreign currency only at Himbol (the state exchange) or spend it at official hotels: the UK FCDO says you must be able to account for foreign currency spent when you leave or risk prosecution and a severe fine, and you may not take more than 1,000 nakfa out of Eritrea.",
        "The UK FCDO says you must declare all laptops, mobile phones, cameras and other electronic items on arrival, or they can be confiscated when you leave."
      ]
    }

  "tips": [
    {
      "id": "travel-permits",
      "type": "warning",
      "text": "The UK FCDO says foreign nationals must apply in advance for a permit to travel outside Asmara’s surrounding province, Zoba Maekel, and to some sites in the capital such as the tank graveyard. Tourists apply to the Ministry of Tourism; processing can take several days, permits are not always granted, and they are checked at checkpoints outside Asmara."
    },
    {
      "id": "border-areas",
      "type": "warning",
      "text": "The UK FCDO advises against all travel within 25 km of Eritrea’s borders with Djibouti, Ethiopia and Sudan; the Australian government says landmines are found within 25 km of the border with Ethiopia."
    },
    {
      "id": "cash-only",
      "type": "info",
      "text": "The Government of Canada says credit cards are not accepted for everyday transactions and that money should be exchanged only through Himbol, main banks or major hotels; the UK FCDO says foreign currency must be declared on arrival and that you must be able to account for foreign currency spent when you leave."
    },
    {
      "id": "communications",
      "type": "info",
      "text": "The UK FCDO says internet access is highly restricted and mostly limited to hotels and a few internet cafes, there is no 3G, international SIM cards do not work, and a local SIM requires a residence permit."
    },
    {
      "id": "photography",
      "type": "info",
      "text": "Photographing government buildings and military installations is illegal (UK FCDO), and the Government of Canada also lists airports, ports and uniformed service members. The UK FCDO says to always ask before taking photos in any area where security personnel are present."
    }
  ],
  "faq": [
    {
      "id": "need-visa",
      "question": "Do I need a visa for Eritrea?",
      "answer": "No official Eritrean page we could read says which nationalities need a visa. The UK, Canadian, Australian, Irish and Serbian governments say their citizens need one to enter. The Eritrean Embassy in Switzerland says a visa is issued ten working days after it receives the application and fee, and that issue is not assured."
    },
    {
      "id": "processing-time",
      "question": "How long does an Eritrean visa take?",
      "answer": "The Eritrean Embassy in Switzerland says a visa is issued ten working days after it receives the application and fee, and is valid for three months from issue. Approval is not guaranteed."
    },
    {
      "id": "outside-asmara",
      "question": "Can I travel outside Asmara in Eritrea?",
      "answer": "Only with a travel permit. The UK FCDO says foreign nationals need a permit, applied for in advance, to travel outside Asmara’s surrounding province (Zoba Maekel) and to some sites in the capital. Tourists apply to the Ministry of Tourism; processing can take several days, permits are not always granted, and they are checked at checkpoints."
    },
    {
      "id": "money",
      "question": "Can I use cards or ATMs in Eritrea?",
      "answer": "No for everyday purchases: the Government of Canada says credit cards are not accepted for everyday transactions and Eritrea runs on cash. Declare foreign currency on arrival, exchange it only at Himbol, main banks or major hotels, and keep the receipts — the UK FCDO says you must account for foreign currency spent when you leave."
    },
    {
      "id": "is-eritrea-safe",
      "question": "Is Eritrea safe to visit?",
      "answer": "The UK FCDO says Asmara is a relatively safe city, though there is a risk of street crime especially at night. It advises against all travel within 25 km of the land borders, says movement outside the Asmara region needs a permit and international SIM cards do not work, and that consular help is severely limited."
    }
  ]

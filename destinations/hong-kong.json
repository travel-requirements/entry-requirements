      "CN": {
        "requirement": "travel-permit",
        "maxStayDays": null,
        "notes": "The Immigration Department says Mainland residents who wish to visit Hong Kong must obtain an Exit-entry Permit (EEP) and an appropriate exit endorsement from the relevant Public Security Bureau Office; in general, a Mainland resident holding a valid EEP with a valid exit endorsement may be landed as a visitor, with a limit of stay in line with the endorsement, provided normal immigration requirements are met.",
        "source": {
          "url": "https://www.immd.gov.hk/eng/services/visas/overseas-chinese-entry-arrangement.html",
          "name": "Hong Kong Immigration Department — Entry Arrangements for Mainland, Macao, Taiwan & Overseas Chinese Residents",
          "type": "government",
          "lastVerified": "2026-10-08",
          "lastChanged": "2026-10-08",
          "instrument": "Immigration Ordinance (Cap. 115)"
        },
        "quote": {
          "text": "Under current arrangements, Mainland residents who wish to visit Hong Kong are required to obtain an EEP and an appropriate exit endorsement from the relevant Public Security Bureau Office. In general, a Mainland resident who is in possession of a valid EEP bearing a valid exit endorsement may be landed in Hong Kong as a visitor, with a limit of stay in accordance with the exit endorsement, provided that normal immigration requirements are met.",
          "url": "https://www.immd.gov.hk/eng/services/visas/overseas-chinese-entry-arrangement.html"
        }

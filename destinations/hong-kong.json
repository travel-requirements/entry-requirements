  "tips": [
    {
      "id": "mainland-visa",
      "type": "info",
      "text": "The Government of Canada says that if you plan to visit or transit through mainland China you should obtain a Chinese visa before your trip, and that travel between Hong Kong, Macao and mainland China needs a visa allowing multiple entries."
    },
    {
      "id": "par-india",
      "type": "info",
      "text": "Indian nationals must complete the free online Pre-arrival Registration before they can visit Hong Kong visa-free. A registration is valid for six months and allows multiple visits of up to 14 days each."
    },
    {
      "id": "typhoons",
      "type": "warning",
      "text": "The UK FCDO says the typhoon season runs from May to November, that public offices and public transport shut down when a Typhoon 8 signal is raised, and that you should follow local warnings and check the Hong Kong Observatory."
    }
  ],
  "faq": [
    {
      "id": "need-visa",
      "question": "Do I need a visa for Hong Kong?",
      "answer": "Probably not: nationals of the countries on the Immigration Department’s visa-free list enter without a visa for 7 to 180 days depending on passport — for example 90 days for nationals of the US, Canada, Australia and Japan, and 180 days for British citizens. Indian nationals pre-register online for free; nationals of the countries on its visa-required list need an advance entry visa from the Immigration Department."
    },
    {
      "id": "china-visa",
      "question": "Is a Chinese visa valid for Hong Kong?",
      "answer": "No official source we could read says a mainland Chinese visa is valid for Hong Kong: Hong Kong's Immigration Department publishes its own visa requirements, under which most nationalities visit visa-free. The Government of Canada says that if you plan to visit or transit through mainland China you should obtain a Chinese visa before your trip."
    },
    {
      "id": "uk-stay",
      "question": "How long can British citizens stay in Hong Kong?",
      "answer": "British citizens can visit visa-free for up to 180 days — the most generous tier of Hong Kong's visa-waiver arrangements."
    },
    {
      "id": "india-par",
      "question": "Do Indian citizens need a visa for Hong Kong?",
      "answer": "Not a visa, but a Pre-arrival Registration (PAR) — a free online registration with the Immigration Department completed before travel. It is valid for 6 months and allows multiple visits of up to 14 days each; airlines check it at boarding."
    },
    {
      "id": "extend",
      "question": "Can I extend my stay in Hong Kong as a visitor?",
      "answer": "Extension of limit of stay is applied for at the Immigration Department; its fee table lists HK$330 for a change of condition of stay, including an extension of limit of stay. The Department says that, except in the most unusual circumstances, visitors are not allowed to change their immigration status after arrival. No official source we could read states when a visitor's extension is granted."
    }
  ]

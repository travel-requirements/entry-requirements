  "faq": [
    {
      "id": "us-need-visa",
      "question": "Do US citizens need a visa for India?",
      "answer": "Yes. US passport holders need a visa for India; most tourists use the e-Tourist Visa (30 days, 1 year or 5 years), applied for online at indianvisaonline.gov.in. Apply at least 4 days before travel."
    },
    {
      "id": "evisa-cost",
      "question": "How much does an India eVisa cost?",
      "answer": "The 30-day e-Tourist Visa has a standard fee of 25 USD (10 USD for April–June arrivals), the 1-year version 40 USD, and the 5-year version 80 USD. Fees differ for a few nationalities — the official portal shows your exact fee before payment."
    },
    {
      "id": "evisa-time",
      "question": "How long does the India eVisa take?",
      "answer": "Most eVisas are approved within 1–4 business days. Apply at least 4 days before your flight; you cannot use the eVisa scheme more than twice per calendar year for the 30-day version."
    },
    {
      "id": "yellow-fever",
      "question": "Do I need vaccinations to enter India?",
      "answer": "Only conditionally: a yellow fever certificate if you arrive from a risk country (strictly enforced — quarantine applies without it), and a polio vaccination certificate if arriving from a polio-affected country. No vaccinations are required when flying directly from Europe, the Americas or most of Asia."
    },
    {
      "id": "extend-evisa",
      "question": "Can I extend an India eVisa?",
      "answer": "Tourist eVisas cannot be extended. For longer stays, use the 1-year or 5-year multiple-entry eVisa (max 90 days per visit for most nationalities) or a regular embassy visa."
    }
  ]
}

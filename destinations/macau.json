    "customs": {
      "currencyLimits": {
        "text": "Arriving travelers carrying cash or bearer negotiable instruments (traveler's checks, cheques, money orders) worth MOP 120,000 or more must declare them to customs and use the red channel. On departure, declare truthfully if a customs officer asks. Transit passengers are exempt.",
        "source": {
          "url": "https://www.customs.gov.mo/cn/notice_passengers_item2.html",
          "name": "Macao Customs Service — Control of cross-border transportation of cash and bearer negotiable instruments",

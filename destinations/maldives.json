  "tips": [
    {
      "id": "alcohol-rules",
      "type": "warning",
      "text": "The UK Foreign Office says alcoholic drinks are available only on resort islands and you should not take any out of your resort: you can be arrested and deported for possessing or drinking alcohol, or being intoxicated, outside resorts and on inhabited islands. Importing alcohol is illegal."
    },
    {
      "id": "local-island-dress",
      "type": "info",
      "text": "Canada's travel advice says to dress conservatively, especially outside major cities and coastal resorts, and notes that publicly observing any religion other than Islam is illegal. The UK Foreign Office says that during Ramadan you should not eat, drink or smoke in public in the daytime outside holiday resorts."
    },
    {
      "id": "imuga-free",
      "type": "tip",
      "text": "The Imuga Traveller Declaration is free at imuga.immigration.gov.mv and must be submitted within 96 hours before your flight for arrival; the Imuga home page lists departure too. Maldives Immigration advises against other websites that may charge a fee."
    }
  ],
  "faq": [
    {
      "id": "need-visa",
      "question": "Do I need a visa for the Maldives?",
      "answer": "No advance visa: Maldives Immigration grants tourists a visa on arrival without pre-approval, provided you have confirmed return tickets, a prepaid confirmed booking, sufficient funds and a submitted Imuga declaration. Entry is not granted on Israeli passports. The UK and Canada say the visa is for 30 days; Australia says it is free."
    },
    {
      "id": "imuga-what",
      "question": "What is the Imuga Traveller Declaration?",
      "answer": "Imuga is the Maldives' online traveller declaration. Maldives Immigration says all travellers must submit it within 96 hours before their flight time for arrival, and its home page lists it as mandatory within 96 hours of arrival or departure. Submitting it at imuga.immigration.gov.mv is free."
    },
    {
      "id": "extend-90",
      "question": "Can I stay in the Maldives longer than 30 days?",
      "answer": "Yes. The free 30-day visa on arrival can be extended in-country by applying through the IMUGA portal before your first 30 days expire. Your passport and accommodation details are filled in automatically (you can update your hotel if you have moved) and you upload a recent photo; Immigration expects to decide applications within 48 hours. It does not publish the maximum length of an extension or the fee."
    },
    {
      "id": "alcohol",
      "question": "Can I bring alcohol into the Maldives?",
      "answer": "No. Canada's travel advice says importing alcohol is illegal, and the UK Foreign Office says it is illegal to bring in alcohol. Alcohol is available only on resort islands; you can be arrested and deported for possessing or drinking it outside resorts."
    },
    {
      "id": "usd-accepted",
      "question": "Do I need to change money into rufiyaa?",
      "answer": "Canada's travel advice says the currency is the rufiyaa (MVR), that major credit cards are accepted at resorts and hotels, and that US dollars can be exchanged at the airport, banks and hotels. ATMs are only in Malé and the more populated non-resort islands."
    }
  ]

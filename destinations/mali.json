  "tips": [
    {
      "id": "security",
      "type": "warning",
      "text": "The UK advises against all travel to the whole of Mali, including Bamako. It says terrorist attacks can occur at any time, that JNIM blockades target key routes, and that there is a high threat of kidnapping across the country."
    },
    {
      "id": "ecowas-status",
      "type": "info",
      "text": "ECOWAS says Burkina Faso, Mali and Niger have officially withdrawn from ECOWAS. The Ministry of Foreign Affairs' visa check still waives the visa for nationals of Benin, Côte d'Ivoire, Gambia, Guinea, Guinea-Bissau, Nigeria, Senegal and Togo, but asks those of Cape Verde, Ghana, Liberia and Sierra Leone to apply."
    },
    {
      "id": "photography",
      "type": "warning",
      "text": "The UK Foreign Office says not to take pictures of military or government installations and to always ask permission before photographing local people; Canada says photographing military personnel and installations is prohibited."
    },
    {
      "id": "cash-euros",
      "type": "tip",
      "text": "Canada's travel advice says credit cards are rarely accepted outside a few major hotels and that ATM access is limited outside Bamako."
    }
  ],
  "faq": [
    {
      "id": "need-visa",
      "question": "Do I need a visa for Mali?",
      "answer": "The UK government says British nationals must have a visa to visit Mali. The application and payment are made online through the Malian Ministry of Foreign Affairs' website, and the entry permit is issued electronically once approved. The ministry's visa check tells nationals of Benin, Côte d'Ivoire, Gambia, Guinea, Guinea-Bissau, Nigeria, Senegal, Togo, Burkina Faso and Niger that they need no visa."
    },
    {
      "id": "safe",
      "question": "Is Mali safe to visit?",
      "answer": "No. The UK and Canadian governments both advise against all travel to Mali; Canada cites the threat of terrorism, kidnapping, banditry and fuel shortages."
    },
    {
      "id": "ecowas-free",
      "question": "Can ECOWAS citizens still enter Mali visa-free?",
      "answer": "Some can. Although Mali, Burkina Faso and Niger have withdrawn from ECOWAS, the Malian Ministry of Foreign Affairs' visa check still tells nationals of Benin, Côte d'Ivoire, Gambia, Guinea, Guinea-Bissau, Nigeria, Senegal and Togo that they need no visa. Nationals of Cape Verde, Ghana, Liberia and Sierra Leone are told a visa is required."
    },
    {
      "id": "voa",
      "question": "Can I get a visa on arrival in Mali?",
      "answer": "No official source we could read offers a visa on arrival. The UK Foreign Office tells British nationals that they must have a visa to visit Mali, that the application and payment are made online through the Malian Ministry of Foreign Affairs website, and that the entry permit is issued electronically once approved, with no need to send documents to the Malian embassy."
    },
    {
      "id": "yellow-fever",
      "question": "Do I need a yellow fever vaccination for Mali?",
      "answer": "Yes. The UK Foreign Office says you must have a certificate proving yellow fever vaccination to enter Mali."
    }
  ]

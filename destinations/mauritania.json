    "declarations": [],
    "customs": {
      "currencyLimits": {
        "text": "Australia's Smartraveller says it is illegal to import or export ouguiyas, that any foreign currency must be declared on arrival (there is no limit on the amount), and that you cannot leave with more foreign currency than you declared. No Mauritanian source we could read publishes a declaration threshold.",
        "source": {
          "url": "https://www.smartraveller.gov.au/destinations/africa/mauritania",
          "name": "Australian Government Smartraveller — Mauritania travel advice (money)",
          "type": "government",
          "lastVerified": "2026-10-06",
          "lastChanged": "2026-10-03"
        }
      },
      "notes": [
        "The UK government says it is illegal for Muslims and non-Muslims alike to import or consume alcohol or pork products. Baggage is scanned on arrival at Nouakchott airport and vehicles may be searched at land borders; alcohol and pork are confiscated, and people carrying them can be arrested or fined."
      ]
    }
  },
  "countryFacts": {
    "currency": {
      "code": "MRU",
      "name": "Mauritanian ouguiya",
      "symbol": "UM"
    },
    "payments": {
      "cardsAccepted": "rare",
      "cashImportance": "high",
      "text": "The UK government says Mauritania is mainly a cash-based society: a few hotels in Nouakchott and Nouadhibou accept credit cards (some only Visa), and some ATMs accept foreign cards. US dollars and euros can be exchanged at banks, some hotels and official bureaux de change. Australia's Smartraveller adds that you must declare foreign currency on arrival and cannot leave with more than you declared."
    },
    "safety": {
      "level": "high-risk",
      "text": "The UK Foreign Office advises against all travel to the east and to within 25 km of the Mali border because of terrorism risk, and against all but essential travel to much of the rest of the interior, including the southern provinces. It says crime levels are moderate but steadily increasing, with thefts and robberies at knifepoint on unlit, isolated beaches in Nouakchott.",
      "source": {
        "url": "https://www.gov.uk/foreign-travel-advice/mauritania",

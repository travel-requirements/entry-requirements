  "tips": [
    {
      "id": "bring-cash",
      "type": "tip",
      "text": "The currency is the US dollar. The UK FCDO says ATM facilities are limited, and Canada says there are few ATMs."
    },
    {
      "id": "modest-dress",
      "type": "info",
      "text": "Canada's travel advice says to dress conservatively, behave discreetly and respect religious and social traditions. It also says drunkenness and drinking in public places are punishable offences."
    },
    {
      "id": "war-remnants",
      "type": "warning",
      "text": "Canada's travel advice says unexploded World War II ordnance may pose a risk: if you dive or boat, avoid doing so after daylight hours, keep away from areas where sunken vessels or planes have been reported, and do not touch war remnants. Removing anything from a World War II wreck is illegal."
    }
  ],
  "faq": [
    {
      "id": "need-visa",
      "question": "Do I need a visa for Micronesia?",
      "answer": "Not for visits of 30 days or less: the FSM requires no permit for them, provided you hold a passport valid at least 120 days beyond the date of entry and can show a return or onward ticket, and complete the CIQ form on arrival. Stays over 30 days need an entry permit. US citizens may be issued an entry permit for the whole visit, up to one year."
    },
    {
      "id": "us-compact",
      "question": "What does the Compact of Free Association mean for US citizens?",
      "answer": "The FSM's visitor regulations say US citizens may enter any FSM state with a US passport or proof of US citizenship (a birth certificate), and may be issued an entry permit for the duration of the visit, up to one year. Each island airport has its own customs and immigration officers."
    },
    {
      "id": "extend-stay",
      "question": "Can I stay longer than 30 days in Micronesia?",
      "answer": "Yes. Visitors staying longer than 30 days need an entry permit, which may be issued for an additional period of up to 60 days."
    },
    {
      "id": "yellow-fever",
      "question": "Do I need any vaccinations for Micronesia?",
      "answer": "The FSM's visitor regulations say vaccination or certification is not required unless the traveller comes from an infected area."
    }
  ]
}

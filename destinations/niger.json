  "faq": [
    {
      "id": "need-visa",
      "question": "Do I need a visa for Niger?",
      "answer": "Niger's Foreign Ministry says all foreigners must present a passport with a Nigerien visa at the border unless a bilateral or community agreement exempts them; it publishes no list of exempt nationalities. The UK government says British nationals need a visa, applied for at the Nigerien embassy in Geneva, and the Canadian and Australian governments say their citizens must obtain a visa before travel. No official source we could read states the rule for other passports."
    },
    {
      "id": "is-it-safe",
      "question": "Is it safe to travel to Niger right now?",
      "answer": "The UK and Canadian governments both advise against all travel to Niger; Canada cites political instability and the risks of terrorism and kidnapping."
    },
    {
      "id": "ecowas-exit",
      "question": "Did Niger's exit from ECOWAS end visa-free travel for West Africans?",
      "answer": "The ECOWAS Commission says the citizens of Burkina Faso, Mali and Niger keep, until further notice, the right to move, reside and settle without visas in ECOWAS states after the three countries' withdrawal took effect on 29 January 2025. No official source we could read states Niger's own rule for ECOWAS citizens."
    },
    {
      "id": "yellow-fever",
      "question": "Is yellow fever vaccination mandatory for Niger?",
      "answer": "Yes — Niger requires a yellow fever vaccination certificate from all arriving travelers aged 9 months and over, whatever country you arrive from."
    },
    {
      "id": "french-citizens",
      "question": "Can French citizens get a visa for Niger?",
      "answer": "No official source we could read states the current visa position for French nationals. Niger's Foreign Ministry says foreigners need a Nigerien visa, applied for at an embassy or consulate."
    }
  ]

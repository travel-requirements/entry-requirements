  "tips": [
    {
      "id": "security-advisories",
      "type": "warning",
      "text": "The UK and Canadian governments both advise against all travel to Niger."
    },
    {
      "id": "overland-borders",
      "type": "warning",
      "text": "Canada's travel advice says to avoid the regions bordering Mali and Burkina Faso, and the UK Foreign Office says banditry and smuggling are common in border areas, particularly Maradi, Tillabéri and Diffa."
    },
    {
      "id": "photography",
      "type": "info",
      "text": "The UK Foreign Office and Canada both say not to photograph military or government installations; Canada adds military personnel and political or student demonstrations, and says to always seek permission before photographing a person."
    },
    {
      "id": "cash-economy",
      "type": "tip",
      "text": "The UK Foreign Office says credit cards are rarely accepted, even in hotels and restaurants used by international visitors, and there are few ATMs."
    }

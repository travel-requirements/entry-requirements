          }
        ]
      }
    },
    "proofOfFunds": {
      "required": true,
      "appliesTo": "all",
      "amount": null,
      "text": "No fixed amount is published, but the visitor permit is granted only if you have documented evidence of sufficient funds to support yourself — typically a copy of a bank statement — and can state where you are staying.",

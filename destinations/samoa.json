    "onwardTicket": {
      "required": true,
      "appliesTo": "all",
      "text": "Samoa Immigration grants the 90-day Visitor Permit only to travellers with confirmed onward or return tickets, a passport valid at least 6 months beyond the intended stay, and visas for their next country of destination.",
      "source": {
        "url": "https://mpmc.gov.ws/divisions/immigration/attheborder/",

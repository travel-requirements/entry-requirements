  "tips": [
    {
      "id": "sunday-and-sa",
      "type": "info",
      "text": "Canada's travel advice says the sale of alcohol is prohibited on Sundays. The UK's says drinking alcohol in public is illegal except at bars or restaurants, and that the legal drinking age is 21."
    },
    {
      "id": "village-etiquette",
      "type": "info",
      "text": "The UK government's travel advice says local communities expect modest dress in towns and villages; swimwear is fine on the beach or by streams and waterfalls but likely to draw negative attention elsewhere. Canada's advises asking permission before entering a lagoon, as villages may hold customary rights over it, and before photographing people."
    },
    {
      "id": "drive-left",
      "type": "warning",
      "text": "Traffic drives on the left (Canada's travel advice). The UK government says you must buy a temporary driving permit, using your home licence, which car rental companies will help with and which covers up to 90 days a year; speed limits are 40 km/h in towns and villages and 56 km/h elsewhere, and any accident must be reported to the police within 24 hours."
    },
    {
      "id": "cash-outside-apia",
      "type": "tip",
      "text": "Canada's travel advice says ATMs are mostly in and around Apia, with one on Savai'i and none elsewhere."
    },
    {
      "id": "cyclone-season",
      "type": "warning",
      "text": "The UK government's travel advice says the tropical cyclone season normally runs from November to the end of April, and that heavier rainfall inland can cause flooding."
    }
  ],
  "faq": [
    {
      "id": "need-visa",
      "question": "Do I need a visa for Samoa?",
      "answer": "No. Samoa Immigration says visitors can apply on arrival, using the arrival card, for a 90-day Visitor Permit; they need a passport valid at least 6 months beyond the stay, confirmed onward tickets, visas for their next destination, sufficient funds and a confirmed address in Samoa. The UK government says the permit is free."
    },
    {
      "id": "how-long",
      "question": "How long can I stay in Samoa?",
      "answer": "The Visitor Permit is issued for up to 90 days. To stay longer, Samoa Immigration says you apply on the temporary residence form, with a copy of an onward ticket, evidence of sufficient funds and details of your accommodation. No current fee is published online."
    },
    {
      "id": "onward-ticket",
      "question": "Do I need a return ticket to enter Samoa?",
      "answer": "Yes. Samoa Immigration grants the free visitor permit only if you have a return or onward ticket. You must also state your accommodation arrangements — a hotel or resort, or the village and family name if staying with family or friends."
    },
    {
      "id": "vaccinations",
      "question": "What vaccinations do I need for Samoa?",
      "answer": "Only a yellow fever certificate, and only if you arrive from a yellow fever risk country, according to the UK government. Samoa's Ministry of Health has no health-related travel restrictions in place. The UK government lists dengue and Zika among the health risks and advises taking precautions against mosquito bites."
    }
  ]

      {
        "id": "yellow-fever",
        "name": "Yellow fever",
        "certificate": "International Certificate of Vaccination or Prophylaxis",
        "requiredWhen": "arriving-from-risk-country",
        "text": "The UK Foreign Office says you must have a yellow fever vaccination certificate if you are coming from a country listed as a transmission risk. WHO's country list gives the requirement for travellers aged 1 year or over arriving from countries with risk of yellow fever transmission, and for travellers who transited for more than 12 hours through an airport of such a country.",
        "source": {
          "url": "https://www.gov.uk/foreign-travel-advice/samoa/entry-requirements",
          "name": "UK Foreign, Commonwealth & Development Office — Samoa entry requirements",
          "type": "government",

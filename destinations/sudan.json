  "tips": [
    {
      "id": "do-not-travel",
      "type": "warning",
      "text": "Sudan is in armed conflict. The UK advises against all travel to almost all of Sudan and Canada says to avoid all travel. Canada's travel advice says drone attacks occur frequently nationwide and that the airports at Port Sudan and Khartoum may close without notice."
    },
    {
      "id": "registration-permits",
      "type": "info",
      "text": "Canada's travel advice says foreigners must register with the Ministry of the Interior's Aliens' Registration Office within 3 days of arrival (some larger hotels do it for a fee), and the UK government says you need a travel permit, applied for in the country, to leave the Red Sea State."
    },
    {
      "id": "israel-stamps",
      "type": "info",
      "text": "Canada's travel advice says the authorities will automatically deny you entry if your passport contains an Israeli stamp."
    }
  ],
  "faq": [
    {
      "id": "need-visa",
      "question": "Do I need a visa for Sudan?",
      "answer": "The UK, Canadian, Australian, Irish and German governments say their citizens need a visa obtained in advance, and the Sudanese embassy in Washington issues entry visas for business or official travel, backed by a letter from a sponsoring organisation. No official source we could read states the rule for other nationalities."
    },
    {
      "id": "open-to-tourists",
      "question": "Is Sudan open to tourists?",
      "answer": "Canada's travel advice says heavy fighting has continued across the country since April 2023 and drone attacks occur frequently. The UK advises against all travel to almost all of Sudan and Canada says to avoid all travel."
    },
    {
      "id": "evisa-voa",
      "question": "Does Sudan have an eVisa or visa on arrival?",
      "answer": "No official source we could read describes an eVisa or a visa on arrival for Sudan. The UK Foreign Office says you must have a visa to enter Sudan and can apply through the Sudanese embassy in the UK or in the country you are travelling from."
    },
    {
      "id": "israel",
      "question": "Can Israeli citizens visit Sudan?",
      "answer": "The UK and Canada say you will be refused entry if your passport contains an Israeli visa or entry or exit stamp. No official source we could read states the rule for Israeli passport holders."
    },
    {
      "id": "which-embassy",
      "question": "Which Sudanese embassy should I apply through?",
      "answer": "The UK Foreign Office says you can apply through the Sudanese embassy in the UK or in the country you are travelling from. Requirements and fees differ between missions: the embassy in Berlin charges EUR 80 for a tourist visa, and the embassy in Washington charges USD 154 to process an entry visa."
    }
  ]

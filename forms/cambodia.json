            },
            {
              "label": "Date Of Passport Expiry",
              "type": "date",
              "required": true
            },
            {
              "label": "Surname",
              "type": "text",
              "required": null
            },
            {
              "label": "Given Name",
              "type": "text",
              "required": true
            },
            {
              "label": "Gender",
              "type": "select",
              "required": true
            },
            {
              "label": "Date Of Birth",
              "type": "date",
              "required": true
            },
            {
              "label": "Country of birth",
              "type": "country",
              "required": null,
              "options": [
                "<countries>"
              ]
            }
          ],
          "notices": [
            "Please enter your information as shown on your passport *",
            "Please check the passport number correctly.",
            "Please enter your passport number and make sure it is still within the expiration date.",
            "Please enter your name as shown on your passport."
          ]
        },
        {
          "order": 2,
          "name": "Travel Information",
          "read": true,
          "fields": [
            {
              "label": "Occupation",
              "type": "text",
              "required": null
            },
            {
              "label": "Email",
              "type": "email",
              "required": null
            },
            {
              "label": "Country/Region Code",
              "type": "select",
              "required": null
            },
            {
              "label": "Phone Number",
              "type": "tel",
              "required": true
            },
            {
              "label": "Date of Arrival in Cambodia",
              "type": "radio",
              "required": true,
              "notes": "Only today and the next six days are offered"
            },
            {
              "label": "Date of Departure from Cambodia",
              "type": "date",
              "required": true
            },
            {
              "label": "Mode of Travel",
              "type": "select",
              "required": null
            },
            {
              "label": "Port of Entry",
              "type": "select",
              "required": true
            },
            {
              "label": "Travel purpose",
              "type": "select",
              "required": null
            },
            {
              "label": "Type of Air Transport",
              "type": "select",
              "required": true,
              "options": [
                "Commercial"
              ]
            },
            {
              "label": "Flight Number",
              "type": "text",
              "required": null
            },
            {
              "label": "Accommodation Type",
              "type": "select",
              "required": true
            },
            {
              "label": "Private residential contact number",
              "type": "tel",
              "required": null
            },
            {
              "label": "Province",
              "type": "select",
              "required": null
            },
            {
              "label": "Last country/Port of Embarkation before Cambodia",
              "type": "select",
              "required": null
            },
            {
              "label": "Next country/Port of Disembarkation after Cambodia",
              "type": "select",
              "required": null
            },
            {
              "label": "Same as last country/port of embarkation before Cambodia",
              "type": "checkbox",
              "required": false
            }
          ],
          "notices": [
            "Please provide your personal phone number. For example, you can share your hotel phone number or the contact details of a friend or relative in Cambodia.",
            "Declaration can only be done within 7 days prior to date of arrival (including the day of arrival) to Cambodia For example, if you are arriving on 7 Oct 2023, you can only submit your declaration from 1 Oct 2023 onwards.",
            "This will be the place which you are residing during your stay in Cambodia.",
            "Please provide the address of your accommodation during your stay in Cambodia, either from your hotel or your residence."
          ]
        },
        {
          "order": 3,
          "name": "Health Information",
          "read": false,
          "fields": []
        },
        {
          "order": 4,
          "name": "Customs Declaration",
          "read": true,
          "fields": [
            {
              "label": "Are you carrying foreign currency or monetary instruments worth over US$10,000 or its equivalent?",
              "type": "radio",
              "required": true,
              "options": [
                "Yes",
                "No"
              ]
            },
            {
              "label": "Have good to declare?",
              "type": "radio",
              "required": true,
              "options": [
                "Yes",
                "No"
              ]
            },
            {
              "label": "I hereby confirm that all the statements in this declaration are true and correct.",
              "type": "checkbox",
              "required": null
            }
          ],
          "notices": [
            "Goods not to declare: Personal effects and duty-free allowances below: Alcohol 2L; Cigarettes 200 Sticks; Cigar 50 Sticks; Tobacco 250 Sticks; 35ml",
            "Passenger less than 18 years old gets allowance on perfume only.",
            "Goods to declare Commercial goods e.g.electronic devices, computers etc. Prohibited/restricted goods c.g. live animals. chemical substances, firearms, explosives etc.",
            "Warning: Carrying illicit drugs is a crime and subject to life-time imprisonment.",
            "Note Any false declaration or failure to declare shall be considered committing offense and subject to fine or penalty by laws."
          ]
        },
        {
          "order": 5,
          "name": "Confirm Declaration",
          "read": true,
          "fields": [
            {
              "label": "I have read and agreed to the declaration.",
              "type": "checkbox",
              "required": true
            }
          ],
          "notices": [
            "I hereby confirm that the information has provided herein, including my local contact and residential details, is true, accurate, and complete to the best of my knowledge and belief. I understand that the truth and accuracy of the information submitted in this form is my responsibility. Should there be any change to the information provided, I undertake to inform the General Department of Immigration (`Authority`), by submitting a fresh declaration. I also undertake to update the information required under this form if requested to do so by the Authority. I understand that if I provide any false, inaccurate, or incomplete information in this form, I may be held liable to offenses related to such action."
          ]
        }
      ]

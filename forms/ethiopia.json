              "required": true
            },
            {
              "name": "departureCountry",
              "label": "Departure Country",
              "type": "country",
              "required": true,
              "options": [
                "<countries>"
              ]
            },
            {
              "name": "departureCity",
              "label": "Departure City",
              "type": "text",
              "required": true
            },
            {
              "name": "airline",
              "label": "Airline",
              "type": "text",
              "required": false
            },
            {
              "name": "flightNumber",
              "label": "Flight Number",
              "type": "text",
              "required": false
            },
            {
              "name": "accommodationType",
              "label": "Accommodation Type",
              "type": "select",
              "required": true
            },
            {
              "name": "accommodationName",
              "label": "Accommodation Name",
              "type": "text",
              "required": true
            },
            {
              "name": "accommodationCity",
              "label": "Accommodation City",
              "type": "text",
              "required": true
            },
            {
              "name": "accommodationStreetAddress",
              "label": "Accommodation Street Address",
              "type": "text",
              "required": true
            },
            {
              "label": "Accommodation Telephone",
              "type": "tel",
              "required": true
            }
          ]
        },
        {
          "order": 3,
          "name": "Personal Information",
          "read": false,
          "fields": []
        },
        {
          "order": 4,
          "name": "Passport Information",
          "read": false,
          "fields": []
        },
        {
          "order": 5,
          "name": "Review",
          "read": false,
          "fields": []
        },
        {
          "order": 6,

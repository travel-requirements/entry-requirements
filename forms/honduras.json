      "readOn": "2026-10-07",
      "requiresAccount": false,
      "stoppedAt": "The declaration is one public page (guest access) and was read in full; every field is personal or trip data, so nothing was filled in or registered.",
      "steps": [
        {
          "order": 1,
          "name": "Declaración Jurada Regional de Viajero",
